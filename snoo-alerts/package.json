{
  "name": "snoo-alerts",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone worker that watches Snoo soothing levels and fires an alert (e.g. Twilio SMS/call) when a configured level is sustained.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
