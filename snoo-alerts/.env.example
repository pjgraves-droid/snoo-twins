# Happiest Baby account (same credentials as the dashboard) — REQUIRED
HAPPIESTBABY_EMAIL=you@example.com
HAPPIESTBABY_PASSWORD=your-password

# Alert rule (all optional — defaults shown)
SNOO_TRIGGER_LEVEL=LEVEL2       # ONLINE|BASELINE|LEVEL1|LEVEL2|LEVEL3|LEVEL4
SNOO_SUSTAIN_SECONDS=30         # level must be held this long before alerting
SNOO_COOLDOWN_SECONDS=300       # min gap between alerts per device
SNOO_POLL_INTERVAL_MS=10000     # how often to poll the Snoo cloud
# SNOO_DEVICE_FILTER=Miles,Charlie   # only watch these serials/names (default: all)

# Quiet hours — only alert inside this window (defaults: 10pm–7am Sydney time).
# Window wraps midnight when start > end. Set start==end for 24h alerting.
SNOO_ALERT_TIMEZONE=Australia/Sydney
SNOO_ALERT_START_HOUR=22        # 0-23, window opens (inclusive)
SNOO_ALERT_END_HOUR=7           # 0-23, window closes (exclusive)

# Twilio (optional). Leave ALL unset to run in dry-run mode (logs alerts to console).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15551234567
# TWILIO_TO=+15557654321
# TWILIO_MODE=sms                     # "sms" or "call"
# TWILIO_VOICE_TWIML_URL=https://handler.twilio.com/twiml/EHxxxx   # required if mode=call
